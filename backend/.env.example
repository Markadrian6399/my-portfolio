# Postgres connection string (Neon: use the direct, non-pooled one)
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio

# Bearer token for admin endpoints (create/update/delete content, /api/messages, /api/stats).
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

PORT=8080

# Set to true when running behind a proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY=false

# Optional: email each contact message via Resend (https://resend.com/api-keys).
# Without a verified domain, Resend only delivers to the address that owns the
# Resend account, so sign up with the same address as CONTACT_TO.
# RESEND_API_KEY=re_...
CONTACT_TO=markodiba6399@gmail.com
# EMAIL_FROM="Portfolio <onboarding@resend.dev>"
